# Copy to .env and edit.

# Name or IP address people use to open SecureDesk.
#   localhost            -> https://localhost            (local test, certificate from Caddy's own CA)
#   desk.example.com     -> https://desk.example.com     (public domain: real Let's Encrypt certificate)
#   192.168.1.50         -> https://192.168.1.50         (LAN IP: certificate from Caddy's own CA)
SECUREDESK_HOST=localhost

# Ports published on the host (change them if 80/443 are already in use).
SECUREDESK_HTTP_PORT=80
SECUREDESK_HTTPS_PORT=443

# First administrator, created automatically on the very first start (empty database only).
# Defaults if you leave them out:  admin@securedesk.local  /  SecureDesk@123   -> change the password after the first login!
#SECUREDESK_ADMIN_EMAIL=admin@securedesk.local
#SECUREDESK_ADMIN_PASSWORD=
# Set to false to disable the automatic administrator (then use the Register button once).
#SECUREDESK_SEED_ADMIN=true

# Image to run (default: the published image).
#SECUREDESK_IMAGE=shubhamwaghagkmf010/securedesk:latest

# Password, one-time code and recovery code fields accept only text typed by hand (no paste, no autofill).
# Set to false to allow pasting and password managers.
#SECUREDESK_BLOCK_PASTE=true
