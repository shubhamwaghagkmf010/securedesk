<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style build of the Windows installer. It compiles exactly the same sources as Agent.Installer.Win.csproj,
    but can be built with "dotnet build" (no Visual Studio / tlbimp needed). Output: Remotely_Installer.exe
    (file name kept on purpose: the server, agent updater and docs reference it by this name).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Remotely_Installer</AssemblyName>
    <RootNamespace>Remotely.Agent.Installer.Win</RootNamespace>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Models\ConnectionInfo.cs" Link="Models\ConnectionInfo.cs" />
    <Compile Include="..\Shared\Models\EmbeddedServer.cs" Link="Models\EmbeddedServer.cs" />
    <Compile Include="..\Shared\Models\DeviceSetupOptions.cs" Link="Models\DeviceSetupOptions.cs" />
    <Compile Include="..\Shared\Utilities\AppConstants.cs" Link="Utilities\AppConstants.cs" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="Models\BrandingInfo.cs" />
    <Compile Include="Utilities\CommandLineParser.cs" />
    <Compile Include="Utilities\MessageBoxEx.cs" />
    <Compile Include="Utilities\Logger.cs" />
    <Compile Include="Utilities\ProcessEx.cs" />
    <Compile Include="Services\Executor.cs" />
    <Compile Include="Services\InstallerService.cs" />
    <Compile Include="ViewModels\MainWindowViewModel.cs" />
    <Compile Include="ViewModels\ViewModelBase.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs" />
    <Compile Include="Properties\Settings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\favicon.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\inst_bg.png" />
    <EmbeddedResource Include="Assets\Remotely_Icon.png" />
  </ItemGroup>

</Project>
