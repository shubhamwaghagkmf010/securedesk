# SecureDesk - Active Directory login settings.
# Copy this file to ad-config.env, fill it in, then run ./apply-ad.sh (one level up).
# ad-config.env holds a password: it is never committed to Git and never copied into the image.
# Comments must be on their own line (a # after a value becomes part of the value).

# apply-ad.sh sets this to true after the checks pass. false = Active Directory login is off.
AD_ENABLED=false

# Domain controller name or IP, for example dc01.company.local
AD_SERVER=
# 636 for LDAPS (recommended). 389 only with StartTLS-less lab setups (needs AD_ALLOW_INSECURE=true)
AD_PORT=636
AD_USE_LDAPS=true
# Domain name, for example company.local (used to name the SecureDesk user: raju@company.local)
AD_DOMAIN=
# Where to search for users, for example DC=company,DC=local
AD_BASE_DN=

# HOW SECUREDESK TALKS TO THE DIRECTORY - choose one:
#   service = a read-only service account looks the user up, then the user's password is checked (default)
#   user    = no service account at all; the person signs in with their own password and SecureDesk reads
#             that same account back. Nothing secret is stored in this file. Test it with: ./apply-ad.sh --test-login USER
AD_BIND_MODE=service

# Only for AD_BIND_MODE=service. Read-only service account: full DN or user@domain, for example svc-securedesk@company.local
AD_SERVICE_ACCOUNT=
AD_SERVICE_PASSWORD=

# Only for AD_BIND_MODE=user. The name sent to the directory is {user}@{suffix}.
# The suffix is the UPN suffix of your users (default: AD_DOMAIN). Leave AD_USER_BIND_FORMAT as it is for Active Directory.
AD_UPN_SUFFIX=
AD_USER_BIND_FORMAT={user}@{suffix}

# WHO MAY LOG IN
#   AD_ALLOW_LIST=true  (default): a person must be listed in ad-users.txt. People type only their username (for example raju).
#   AD_ALLOW_LIST=false : no list; every member of the groups below can log in (add a person to the group in AD, nothing to do here).
#                         Needs at least one group. Only an explicit "false" turns the list off.
AD_ALLOW_LIST=true
# Optional with the list, required without it: AD group (name or full DN). Members of the admins group become Organization Admins.
# If you fill in either group, a person must be in one of the two groups to log in. Only direct members count (no nested groups).
AD_ADMINS_GROUP=
AD_TECHS_GROUP=

# Optional: the company CA certificate (PEM/CRT) if the domain controller certificate is signed by an internal CA.
# The path is inside the container: put the file in this folder and write /ad/ca.crt
AD_CA_CERT_FILE=

# SECURITY SETTING, server administrator only. true = every AD user must use an authenticator app code.
# Only an explicit "false" turns it off (and apply-ad.sh then needs --allow-no-2fa). Not changeable from the web console.
AD_REQUIRE_2FA=true

# Advanced (leave as is for Active Directory)
AD_USER_ATTRIBUTE=sAMAccountName
AD_USER_FILTER=(&(objectCategory=person)(objectClass=user))
AD_ALLOW_INSECURE=false
