{
	# Needed when the site is opened by IP address (browsers send no SNI for IPs).
	default_sni {$SECUREDESK_HOST:localhost}
}

# Real domain      -> Caddy gets a public Let's Encrypt certificate automatically (ports 80 and 443 must be reachable).
# localhost / IP   -> Caddy issues a certificate from its own local CA (see README, "HTTPS").
{$SECUREDESK_HOST:localhost} {
	encode gzip
	reverse_proxy securedesk:5000
}

# Any other name or IP address that reaches this server (for example the server's LAN IP while SECUREDESK_HOST is still
# "localhost") is served too, with a certificate from Caddy's own local CA, instead of an empty page.
:443 {
	tls internal {
		on_demand
	}
	encode gzip
	reverse_proxy securedesk:5000
}
